<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <h1 class="hero__title">Connecting Rural Infrastructure, Workforce, and <span class="text-accent">Communities</span></h1>
      <p class="hero__subtitle">Rural ConnectMe explores how broadband expansion can be integrated with workforce development and digital participation so rural communities can translate connectivity investments into real economic growth.</p>
      <div class="hero__actions">
        <a href="#ecosystem" class="btn btn--primary btn--lg">Explore the Rural Ecosystem</a>
        <a href="#approach" class="btn btn--outline btn--lg">Learn More</a>
      </div>
    </div>
    <div class="hero__visual">
      <video
        class="hero__illustration"
        src="https://rconnectme.blob.core.windows.net/webcontent/rmconnect_video.mp4#t=0.1"
        controls
        muted
        playsinline
        preload="metadata"
        aria-label="Rural ConnectMe overview video">
      </video>
    </div>
  </div>
</section>
